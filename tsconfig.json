{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["dom", "es2020"],
    "paths": {
      "*": ["./pkg/lib/*"]
    },
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": false,
    "target": "es2020"
  },
  "include": [
    "src/**/*"
  ]
}
